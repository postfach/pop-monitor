# Portainer: Stacks > Add stack > Environment variables (or "Load variables from .env file")
POP_API_KEY=change-me-long-random-string
POP_HMAC_KEY=change-me-another-long-random-string
POP_CAMERA_PASSWORD=password-of-the-camera-user
POP_TEAMS_WEBHOOK=
POP_SLACK_WEBHOOK=
TZ=Pacific/Auckland
POP_CONFIG_PATH=/opt/pop-monitor/config.json
POP_REVIEW_PORT=8080
POP_VERSION=0.1.0
REVIEW_USER=
REVIEW_PASSWORD=
# Artwork sync from SharePoint (creatives-sync): see docs/sharepoint-setup.md
AZ_TENANT_ID=
AZ_CLIENT_ID=
AZ_CLIENT_SECRET=
AZ_SECRET_EXPIRES=
SYNC_INTERVAL_MIN=240
# Best PoP photos into SharePoint (Booked Campaigns/PoP Images): day photos at 8pm, night at 8am.
# Needs the app to have write access (setup-sharepoint-app.ps1 -PermissionOnly). 0 turns it off.
POP_UPLOAD=1
POP_DAY_AT=20:00
POP_NIGHT_AT=08:00
# Sites outside Auckland, for day/night (optional): SITE_ID=lat,lon;SITE_ID=lat,lon
POP_SITE_COORDS=
