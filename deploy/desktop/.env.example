# Copy to .env (same folder) and fill in. Any long random strings work for the two keys.
POP_API_KEY=change-me-long-random-string
POP_HMAC_KEY=change-me-another-long-random-string
POP_CAMERA_PASSWORD=password-of-the-pop-monitor-camera-user
POP_TEAMS_WEBHOOK=
POP_SLACK_WEBHOOK=
TZ=Pacific/Auckland
# Change if 8080 is already used on this PC
POP_REVIEW_PORT=8080
# Optional login for the review page (recommended if others are on your network)
REVIEW_USER=
REVIEW_PASSWORD=
# Artwork sync from SharePoint (creatives-sync). Filled in by
# deploy/sharepoint/setup-sharepoint-app.ps1; leave blank to upload artwork by hand.
AZ_TENANT_ID=
AZ_CLIENT_ID=
AZ_CLIENT_SECRET=
AZ_SECRET_EXPIRES=
# Optional: minutes between full refreshes (a new Vault pull always syncs within 5 min)
SYNC_INTERVAL_MIN=240
